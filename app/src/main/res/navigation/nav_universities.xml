<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_univercities"
    app:startDestination="@id/universitiesPaymentFragment">

    <fragment
        android:id="@+id/universitiesPaymentFragment"
        android:name="com.apps2you.albaraka.ui.transfer.payment.education.universities.UniversitiesPaymentFragment"
        android:label="UniversitiesPaymentFragment"
        tools:layout="@layout/fragment_education_payment">
        <action
            android:id="@+id/action_universitiesPaymentFragment_to_universitySelectionFragment"
            app:destination="@id/universitySelectionFragment"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/stationary"
            app:popEnterAnim="@anim/stationary"
            app:popExitAnim="@anim/slide_down" />
    </fragment>
    <fragment
        android:id="@+id/universitySelectionFragment"
        android:name="com.apps2you.albaraka.ui.transfer.payment.education.universities.UniversitySelectionFragment"
        android:label="UniversitySelectionFragment"
        tools:layout="@layout/fragment_item_selection"/>
</navigation>