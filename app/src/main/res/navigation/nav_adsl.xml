<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_adsl"
    app:startDestination="@id/adslFragment">

    <fragment
        android:id="@+id/adslFragment"
        android:name="com.apps2you.albaraka.ui.transfer.adsl.ADSLFragment"
        android:label=""
        tools:layout="@layout/fragment_adsl">
        <action
            android:id="@+id/action_adslFragment_to_providersFragment"
            app:destination="@id/providersFragment"
            app:enterAnim="@anim/slide_up"
            app:exitAnim="@anim/stationary"
            app:popEnterAnim="@anim/stationary"
            app:popExitAnim="@anim/slide_down" />
    </fragment>

    <fragment
        android:id="@+id/providersFragment"
        android:name="com.apps2you.albaraka.ui.transfer.adsl.ADSLProvidersFragment"
        android:label=""
        tools:layout="@layout/fragment_item_selection" />

</navigation>