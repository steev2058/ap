<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="result"
            type="com.apps2you.albaraka.data.model.FinancingResult" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/padding_calculator"
            android:paddingEnd="@dimen/padding_calculator"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:clipToPadding="false"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                >

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/financing_type"
                    android:textColor="@color/gray"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    />

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/spinner_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_edittext_selector"
                    android:spinnerMode="dropdown"
                    tools:listitem="@layout/item_complaint_spinner"
                    app:layout_constraintTop_toBottomOf="@+id/textView"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_arrow"
                    app:layout_constraintBottom_toBottomOf="@id/spinner_type"
                    app:layout_constraintEnd_toEndOf="@id/spinner_type"
                    app:layout_constraintTop_toTopOf="@id/spinner_type"
                    app:tint="@color/gray" />

                <com.apps2you.albaraka.utils.CustomTextInputLayout
                    android:id="@+id/ti_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColorHint="@color/gray"
                    app:hintEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/spinner_type">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_date"
                        style="@style/InputEt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/duration_in_months"
                        android:inputType="number"
                        android:textAlignment="viewStart"
                        android:textSize="14sp"
                        />
                </com.apps2you.albaraka.utils.CustomTextInputLayout>

                <com.apps2you.albaraka.utils.CustomTextInputLayout
                    android:id="@+id/ti_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColorHint="@color/gray"
                    app:hintEnabled="false"
                    app:layout_constraintTop_toBottomOf="@id/ti_date">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_amount"
                        style="@style/InputEt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/Amount"
                        android:inputType="numberDecimal"
                        android:textDirection="ltr"
                        android:textSize="14sp"
                        />
                </com.apps2you.albaraka.utils.CustomTextInputLayout>

                <Button
                    android:id="@+id/button_submit"
                    style="@style/ButtonPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/calculate"
                    app:layout_constraintTop_toBottomOf="@+id/ti_amount"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

           <androidx.constraintlayout.widget.ConstraintLayout
               android:id="@+id/container"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginTop="20dp"
               app:layout_constraintTop_toBottomOf="@+id/layout_form"
               >

               <TextView
                   android:id="@+id/text"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/calculating_result"
                   android:textColor="@color/gray"
                   android:drawablePadding="12dp"
                   app:drawableStartCompat="@drawable/ic_invoice"
                   app:drawableTint="@color/colorPrimary"
                   app:layout_constraintTop_toTopOf="parent"
                   app:layout_constraintStart_toStartOf="parent"
                   />

               <TextView
                   android:id="@+id/label_min_payment"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/min_first_payment"
                   android:textColor="@color/gray"
                   app:layout_constraintTop_toTopOf="@+id/tv_min_payment"
                   app:layout_constraintStart_toStartOf="parent"
                   />

               <TextView
                   android:id="@+id/tv_min_payment"
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="12dp"
                   android:gravity="end"
                   android:textColor="@color/textColor"
                   android:text="@{result.minFirstPayment}"
                   app:layout_constraintStart_toEndOf="@+id/label_min_payment"
                   app:layout_constraintEnd_toEndOf="parent"
                   app:layout_constraintTop_toBottomOf="@+id/text" />

               <View
                   android:layout_width="match_parent"
                   android:layout_height="@dimen/line_height"
                   android:layout_marginTop="8dp"
                   android:background="@color/gray_light"
                   app:layout_constraintTop_toBottomOf="@+id/tv_min_payment"
                   />

               <TextView
                   android:id="@+id/label_amount"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/financing_amount"
                   android:textColor="@color/gray"
                   app:layout_constraintTop_toTopOf="@+id/tv_amount"
                   app:layout_constraintStart_toStartOf="parent"
                   />

               <TextView
                   android:id="@+id/tv_amount"
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="16dp"
                   android:gravity="end"
                   android:textColor="@color/textColor"
                   android:text="@{result.fundingValue}"
                   app:layout_constraintStart_toEndOf="@+id/label_amount"
                   app:layout_constraintEnd_toEndOf="parent"
                   app:layout_constraintTop_toBottomOf="@+id/tv_min_payment" />

               <View
                   android:layout_width="match_parent"
                   android:layout_height="@dimen/line_height"
                   android:layout_marginTop="8dp"
                   android:background="@color/gray_light"
                   app:layout_constraintTop_toBottomOf="@+id/tv_amount"
                   />

               <TextView
                   android:id="@+id/label_term"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/max_financing_term"
                   android:textColor="@color/gray"
                   app:layout_constraintTop_toTopOf="@+id/tv_term"
                   app:layout_constraintStart_toStartOf="parent"
                   />

               <TextView
                   android:id="@+id/tv_term"
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="16dp"
                   android:gravity="end"
                   android:textColor="@color/textColor"
                   android:text="@{result.maxFinancingTerm}"
                   app:layout_constraintStart_toEndOf="@+id/label_term"
                   app:layout_constraintEnd_toEndOf="parent"
                   app:layout_constraintTop_toBottomOf="@+id/tv_amount" />

               <View
                   android:layout_width="match_parent"
                   android:layout_height="@dimen/line_height"
                   android:layout_marginTop="8dp"
                   android:background="@color/gray_light"
                   app:layout_constraintTop_toBottomOf="@+id/tv_term"
                   />

               <TextView
                   android:id="@+id/label_profit"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/profit_ratio"
                   android:textColor="@color/gray"
                   app:layout_constraintTop_toTopOf="@+id/tv_profit"
                   app:layout_constraintStart_toStartOf="parent"
                   />

               <TextView
                   android:id="@+id/tv_profit"
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="16dp"
                   android:gravity="end"
                   android:textColor="@color/textColor"
                   android:text="@{result.profitPercentage}"
                   app:layout_constraintStart_toEndOf="@+id/label_profit"
                   app:layout_constraintEnd_toEndOf="parent"
                   app:layout_constraintTop_toBottomOf="@+id/tv_term" />

               <View
                   android:layout_width="match_parent"
                   android:layout_height="@dimen/line_height"
                   android:layout_marginTop="8dp"
                   android:background="@color/gray_light"
                   app:layout_constraintTop_toBottomOf="@+id/tv_profit"
                   />

               <TextView
                   android:id="@+id/label_installment"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/monthly_installment"
                   android:textColor="@color/gray"
                   app:layout_constraintTop_toTopOf="@+id/tv_installment"
                   app:layout_constraintStart_toStartOf="parent"
                   />

               <TextView
                   android:id="@+id/tv_installment"
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="16dp"
                   android:gravity="end"
                   android:textColor="@color/textColor"
                   android:text="@{result.monthlyInstallment}"
                   app:layout_constraintStart_toEndOf="@+id/label_installment"
                   app:layout_constraintEnd_toEndOf="parent"
                   app:layout_constraintTop_toBottomOf="@+id/tv_profit" />

               <View
                   android:layout_width="match_parent"
                   android:layout_height="@dimen/line_height"
                   android:layout_marginTop="8dp"
                   android:background="@color/gray_light"
                   app:layout_constraintTop_toBottomOf="@+id/tv_installment"
                   />

               <TextView
                   android:id="@+id/label_income"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/min_income"
                   android:textColor="@color/gray"
                   app:layout_constraintTop_toTopOf="@+id/tv_income"
                   app:layout_constraintStart_toStartOf="parent"
                   />

               <TextView
                   android:id="@+id/tv_income"
                   android:layout_width="0dp"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="16dp"
                   android:gravity="end"
                   android:textColor="@color/textColor"
                   android:text="@{result.minMonthlyIncome}"
                   app:layout_constraintStart_toEndOf="@+id/label_income"
                   app:layout_constraintEnd_toEndOf="parent"
                   app:layout_constraintTop_toBottomOf="@+id/tv_installment" />

               <View
                   android:layout_width="match_parent"
                   android:layout_height="@dimen/line_height"
                   android:layout_marginTop="8dp"
                   android:background="@color/gray_light"
                   app:layout_constraintTop_toBottomOf="@+id/tv_income"
                   />

               <TextView
                   android:id="@+id/tv_calculator_msg"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="16dp"
                   android:textColor="@color/gray"
                   app:layout_constraintTop_toBottomOf="@+id/tv_income"
                   />
           </androidx.constraintlayout.widget.ConstraintLayout>

            <include
                android:id="@+id/progressBar"
                layout="@layout/partial_progressbar"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>