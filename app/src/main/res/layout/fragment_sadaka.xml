<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.apps2you.albaraka.viewmodels.transfer.SadakaViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <include
            android:id="@+id/layout_toolbar"
            layout="@layout/toolbar_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:title="@{@string/donate_to_charities}" />

        <androidx.constraintlayout.motion.widget.MotionLayout
            android:id="@+id/motion_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="@dimen/padding_page_horizontal"
            android:visibility="@{!(viewModel.isContentLoading || viewModel.isFeeLoading) &amp;&amp; !viewModel.isError()}"
            app:layoutDescription="@xml/scene_expandable_accounts_recycler"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_toolbar">

            <!--                Accounts Recycler-->
            <include
                android:id="@+id/layout_expandable_accounts_recycler"
                layout="@layout/layout_expandable_accounts_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_xsmall"
                app:existence="@{!(viewModel.selectedAccount == null)}"
                app:selectedAccount="@{viewModel.selectedAccount}"
                app:title="@{@string/From}" />

            <ScrollView
                android:id="@+id/layout_form"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/margin_medium"
                android:fillViewport="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_expandable_accounts_recycler">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true">

                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:id="@+id/container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            style="@style/InputEt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="0dp">

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/iv_logo"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:padding="@dimen/margin_small"
                                android:src="@{viewModel.selectedItemLiveData.imageURL}"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintDimensionRatio="1:1"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:placeHolder="@{@drawable/ic_charity}"
                                tools:src="@drawable/ic_charity" />

                            <TextView
                                android:id="@+id/button_pick_charity"
                                style="@style/InputEt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:drawablePadding="@dimen/margin_small"
                                android:paddingStart="0dp"
                                android:text="@{viewModel.selectedItemLiveData == null ? @string/choose_charity : viewModel.selectedItemLiveData.name}"
                                android:textColor="@color/gray"
                                app:drawableEndCompat="@drawable/ic_arrow_black"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@id/iv_logo"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="@string/choose_charity" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <Space
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/margin_medium" />

                        <EditText
                            android:id="@+id/et_amount"
                            style="@style/InputEt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_amount"
                            android:drawablePadding="@dimen/margin_small"
                            android:hint="@string/Amount"
                            android:inputType="numberDecimal"
                            android:textDirection="ltr"
                            android:text="@={viewModel.sadakaForm.amount}"
                            android:textColor="@color/gray" />

                        <Space
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/margin_medium" />

                        <EditText
                            android:id="@+id/et_phone"
                            style="@style/InputEt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_phone_call"
                            android:drawablePadding="@dimen/margin_small"
                            android:hint="@string/mobile_number"
                            android:inputType="phone"
                            android:text="@={viewModel.sadakaForm.phoneNumber}"
                            android:textColor="@color/gray" />

                        <Space
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/margin_medium" />

                        <EditText
                            android:id="@+id/et_reason"
                            style="@style/InputEt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_reason"
                            android:drawablePadding="@dimen/margin_small"
                            android:hint="@string/purpose"
                            android:inputType="text"
                            android:maxLines="1"
                            android:text="@={viewModel.sadakaForm.reason}"
                            android:textColor="@color/gray" />

                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <Button
                        android:id="@+id/button_submit"
                        style="@style/ButtonPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/margin_small"
                        android:text="@string/submit"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/container"
                        app:layout_constraintVertical_bias="1" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </ScrollView>
        </androidx.constraintlayout.motion.widget.MotionLayout>

        <include
            android:id="@+id/progressBar"
            layout="@layout/partial_progressbar"
            app:existence="@{viewModel.isContentLoading || viewModel.isFeeLoading}" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>