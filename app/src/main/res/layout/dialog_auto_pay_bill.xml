<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="16dp">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@color/gray"
        android:textStyle="bold"
        android:drawablePadding="@dimen/_5sdp"
        android:text="تعديل فاتورة"
        android:layout_gravity="center" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bills_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp">

        <!-- Divider line -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- TextView in the middle of the divider line -->
        <TextView
            android:id="@+id/text_first_row2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:drawableStart="@drawable/ic_edit_modal"
            android:textColor="@color/gray"
            android:textSize="@dimen/_18sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_form2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/card_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تعديل اسم الفاتورة"
            android:textColor="@color/gray"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <EditText
            android:id="@+id/billLabel"
            style="@style/InputEt"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/margin_small"
            android:inputType="text"
            android:hint=""
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/textView5"
            android:text=""
            android:textColor="@color/gray" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_auto_pay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawablePadding="10dp"
            android:padding="12dp"
            android:layout_marginBottom="10dp"
            android:text="تفعيل الدفع التلقائي للفاتورة"
            android:textAlignment="viewStart"
            android:textSize="16sp"
            app:drawableStartCompat="@drawable/ic_auto_pay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/billLabel"
            app:thumbTint="@color/white"
            app:trackTint="@color/switch_auto_pay_color" />
        <View
            android:id="@+id/divider_notification"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_margin="10dp"
            android:visibility="gone"
            android:background="@color/bright_gray"
            app:layout_constraintTop_toBottomOf="@id/switch_auto_pay" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اختر حساب التسديد الافتراضي"
            android:textColor="@color/gray"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/switch_auto_pay" />
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinner_accounts"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_edittext_selector"
            android:spinnerMode="dropdown"
            app:layout_constraintTop_toBottomOf="@+id/textView2"
            android:visibility="gone"
            tools:listitem="@layout/item_complaint_spinner" />

        <!-- Image view associated with spinner_catigories_add -->
        <ImageView
            android:id="@+id/imageView_catigories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_arrow"
            app:layout_constraintBottom_toBottomOf="@id/spinner_accounts"
            app:layout_constraintEnd_toEndOf="@id/spinner_accounts"
            app:layout_constraintTop_toTopOf="@id/spinner_accounts"
            android:visibility="gone"
            app:tint="@color/gray" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الحد الأعلى للدفع التلقائي"
            android:textColor="@color/gray"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinner_accounts" />
        <EditText
            android:id="@+id/max_amount"
            style="@style/InputEt"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_hashtag"
            android:drawablePadding="@dimen/margin_small"
            android:inputType="text"
            android:hint="مثال : 10,000 SP"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/textView3"
            android:text=""
            android:visibility="gone"
            android:textColor="@color/gray" />


        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="وقت التحقق"
            android:visibility="gone"
            android:textColor="@color/gray"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/max_amount" />
        <EditText
            android:id="@+id/pick_time"
            style="@style/InputEt"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_time_sep"
            android:drawablePadding="@dimen/margin_small"
            android:inputType="text"
            android:hint=""
            android:visibility="gone"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/textView4"
            android:text=""
            android:textColor="@color/gray" />






        <!-- Submit button -->
        <Button
            android:id="@+id/button_submit"
            style="@style/ButtonPrimary2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="تحديث البيانات"
            app:layout_constraintTop_toBottomOf="@+id/pick_time" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
