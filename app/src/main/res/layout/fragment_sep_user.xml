<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.apps2you.albaraka.viewmodels.transfer.SEPViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:filterTouchesWhenObscured="true"
        tools:context=".UserSepProfileFragment">

        <include
            android:id="@+id/pdf_hear"
            layout="@layout/layout_pdf_header"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الملف الشخصي"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- User Information Section -->
        <LinearLayout
            android:id="@+id/user_info_section"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:drawable/editbox_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="معلومات الزبون"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginBottom="16dp">

                <!-- Four EditTexts for user information -->
                <EditText
                    android:id="@+id/arNameEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:hint="ArName"
                    android:layout_margin="4dp" />

                <EditText
                    android:id="@+id/addressEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:hint="Address"
                    android:layout_margin="4dp" />

                <EditText
                    android:id="@+id/phoneEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:hint="Phone"
                    android:layout_margin="4dp" />

                <EditText
                    android:id="@+id/cifEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:hint="cif"
                    android:layout_margin="4dp" />
            </GridLayout>
        </LinearLayout>

        <!-- My Payments Section -->
        <TextView
            android:id="@+id/tv_my_payments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مدفوعاتي"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/user_info_section"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spinner_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_my_payments"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_arrow"
            app:layout_constraintBottom_toBottomOf="@+id/spinner_account"
            app:layout_constraintEnd_toEndOf="@id/spinner_account"
            app:layout_constraintTop_toTopOf="@id/spinner_account" />

        <TextView
            android:id="@+id/tv_label_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="من"
            app:layout_constraintBottom_toTopOf="@+id/tv_from"
            app:layout_constraintStart_toStartOf="@+id/tv_from" />

        <TextView
            android:id="@+id/tv_label_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="الى"
            app:layout_constraintBottom_toTopOf="@+id/tv_to"
            app:layout_constraintStart_toStartOf="@+id/tv_to" />

        <TextView
            android:id="@+id/tv_from"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/text_padding"
            android:layout_marginTop="28dp"
            android:text="من"
            android:textColor="@color/gray"
            android:padding="12dp"
            android:gravity="center"
            android:background="@drawable/bg_shadow_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_to"
            app:layout_constraintTop_toBottomOf="@id/spinner_account" />

        <TextView
            android:id="@+id/tv_to"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/text_padding"
            android:layout_marginEnd="@dimen/text_padding"
            android:text="الى"
            android:textColor="@color/gray"
            android:padding="12dp"
            android:gravity="center"
            android:background="@drawable/bg_shadow_white"
            app:layout_constraintEnd_toStartOf="@+id/iBtn_submit"
            app:layout_constraintStart_toEndOf="@id/tv_from"
            app:layout_constraintTop_toTopOf="@+id/tv_from" />

        <ImageButton
            android:id="@+id/iBtn_submit"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_search_24"
            android:background="@drawable/bg_shadow_gray"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="@+id/tv_to"
            app:layout_constraintBottom_toBottomOf="@+id/tv_to"
            app:layout_constraintEnd_toEndOf="parent" />

        <include
            android:id="@+id/progressBar"
            layout="@layout/partial_progressbar"
            app:layout_constraintTop_toBottomOf="@id/iBtn_submit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/transactions_recyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/padding_home"
            android:layout_marginTop="@dimen/padding_home"
            android:layout_marginEnd="@dimen/padding_home"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_from"
            tools:itemCount="15"
            tools:listitem="@layout/item_transaction" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
