            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="الى"
            app:layout_constraintBottom_toTopOf="@+id/tv_to"
            app:layout_constraintStart_toStartOf="@+id/tv_to" />

        <TextView
            android:id="@+id/tv_from"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/text_padding"
            android:layout_marginTop="28dp"
            android:text="من"
            android:textColor="@color/gray"
            android:padding="12dp"
            android:gravity="center"
            android:background="@drawable/bg_shadow_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_to"
            app:layout_constraintTop_toBottomOf="@id/txt" />

        <TextView
            android:id="@+id/tv_to"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/text_padding"
            android:layout_marginEnd="@dimen/text_padding"
            android:text="الى"
            android:textColor="@color/gray"
            android:padding="12dp"
            android:gravity="center"
            android:background="@drawable/bg_shadow_white"
            app:layout_constraintEnd_toStartOf="@+id/iBtn_submit"
            app:layout_constraintStart_toEndOf="@id/tv_from"
            app:layout_constraintTop_toTopOf="@+id/tv_from" />

        <ImageButton
            android:id="@+id/iBtn_submit"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_search_24"
            android:background="@drawable/bg_shadow_gray"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="@+id/tv_to"
            app:layout_constraintBottom_toBottomOf="@+id/tv_to"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spinner_categories"
            android:layout_width="370dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="30dp"
            android:padding="10dp"
            android:text="اختر مفوتر"
            app:layout_constraintTop_toBottomOf="@id/tv_to"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@android:drawable/editbox_background"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_arrow_black"
            app:layout_constraintBottom_toBottomOf="@+id/spinner_categories"
            app:layout_constraintEnd_toEndOf="@id/spinner_categories"
            app:layout_constraintTop_toTopOf="@id/spinner_categories" />

