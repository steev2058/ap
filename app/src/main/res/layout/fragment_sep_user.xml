        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/txt"
            android:layout_width="match_parent"
            app:layout_constraintTop_toBottomOf="@id/user_info_section"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp">

            <TextView
                android:id="@+id/text_first_row3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/my_bills_txt"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:layout_marginTop="0dp"
                android:textColor="@color/gray"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>




        <TextView
            android:id="@+id/tv_label_from"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/From"
            app:layout_constraintBottom_toTopOf="@+id/tv_from"
            app:layout_constraintStart_toStartOf="@+id/tv_from" />

        <TextView
            android:id="@+id/tv_label_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/To"
            app:layout_constraintBottom_toTopOf="@+id/tv_to"
            app:layout_constraintStart_toStartOf="@+id/tv_to" />

        <TextView
            android:id="@+id/tv_from"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/text_padding"
            android:layout_marginTop="28dp"
            android:text="@string/From"
            android:textColor="@color/gray"
            android:padding="12dp"
            android:gravity="center"
            android:background="@drawable/bg_shadow_white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_to"
            app:layout_constraintTop_toBottomOf="@id/txt" />

        <TextView
            android:id="@+id/tv_to"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/text_padding"
            android:layout_marginEnd="@dimen/text_padding"
            android:text="@string/To"
            android:textColor="@color/gray"
            android:padding="12dp"
            android:gravity="center"
            android:background="@drawable/bg_shadow_white"
            app:layout_constraintEnd_toStartOf="@+id/iBtn_submit2"
            app:layout_constraintStart_toEndOf="@id/tv_from"
            app:layout_constraintTop_toTopOf="@+id/tv_from" />

        <ImageButton
            android:id="@+id/iBtn_submit2"
            android:layout_width="0dp"
            android:visibility="gone"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_search_24"
            android:background="@drawable/bg_shadow_gray"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="@+id/tv_to"
            app:layout_constraintBottom_toBottomOf="@+id/tv_to"
            app:layout_constraintEnd_toEndOf="parent" />

        <Spinner
            android:id="@+id/spinner_categories"
            android:layout_width="370dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="30dp"
            android:padding="10dp"
            android:text="اختر مفوتر"
            app:layout_constraintTop_toBottomOf="@id/tv_to"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@drawable/bg_edittext_selector"
            app:layout_constraintEnd_toEndOf="parent" />


        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_arrow_black"
            app:layout_constraintBottom_toBottomOf="@+id/spinner_categories"
            app:layout_constraintEnd_toEndOf="@id/spinner_categories"
            app:layout_constraintTop_toTopOf="@id/spinner_categories" />




        <Button
            android:id="@+id/iBtn_submit"
            style="@style/ButtonPrimary"
            android:layout_width="300dp"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="50dp"
            android:layout_height="40dp"
            android:paddingStart="6dp"
            android:textSize="12sp"
            android:text="@string/button"
            android:paddingEnd="12dp"
            app:layout_constraintTop_toBottomOf="@id/spinner_categories"
            android:drawableEnd="@drawable/ic_search_24"
            app:layout_constraintEnd_toEndOf="parent"
            android:textColor="@color/white"/>
        <!-- Divider line -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="45dp"
            android:background="@color/red"
            app:layout_constraintTop_toBottomOf="@+id/iBtn_submit"/>

        <!-- TextView in the middle of the divider line -->
        <TextView
            android:id="@+id/text_first_row2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginTop="30dp"
            android:text="@string/my_bills"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/red"

            app:layout_constraintTop_toBottomOf="@+id/iBtn_submit"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_payments"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/text_first_row2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
