<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Search Bar and Add Button -->
    <EditText
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="200dp"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/add_button"
        android:layout_toLeftOf="@+id/add_button"
        android:layout_marginEnd="8dp"
        android:layout_marginLeft="8dp"
        android:hint="البحث"
        android:padding="8dp"
        android:background="@drawable/bg_radio_button"
        android:gravity="end"
        android:textDirection="ltr" />

    <Button
        android:id="@+id/add_button"
        android:layout_marginTop="200dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:text="إضافة +"
        style="@style/ButtonPrimary"
        android:padding="8dp"
        />

    <!-- Category Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/search_bar"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/button_contacts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="اتصالات"
            android:background="@drawable/bg_radio_button" />

        <Button
            android:id="@+id/button_transport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="نقل"
            android:background="@drawable/bg_radio_button" />

        <Button
            android:id="@+id/button_traffic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مرور"
            android:background="@drawable/bg_radio_button"  />

        <Button
            android:id="@+id/button_water"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مياه"
            android:background="@drawable/bg_radio_button" />
    </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="310dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_radio_button"
            android:padding="20dp">

            <ImageView
                android:id="@+id/left_image"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="0dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_albaraka_transfer"
                android:layout_gravity="center_vertical"/>

            <!-- Divider -->
            <View
                android:id="@+id/divider_contact_time"
                android:layout_width="1dp"
                android:layout_height="70dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_toEndOf="@id/left_image"
                android:layout_marginStart="15dp"
                android:background="@color/bright_gray"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/divider_contact_time"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/image"
                style="@style/ButtonPrimary"
                android:layout_width="60dp"
                android:layout_height="35dp"
                android:layout_marginTop="15dp"
                android:layout_alignParentEnd="true"
                android:text="استعلام"/>

        </RelativeLayout>


</RelativeLayout>
