<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
       <variable
           name="item"
           type="com.apps2you.albaraka.data.model.Account" />

        <variable
            name="position"
            type="int" />
    </data>

    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardUseCompatPadding="true"
        app:cardCornerRadius="@dimen/corner_radius"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                bgColor="@{item.account_type_color}"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_corner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/tv_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:text="@{item.type}"
                android:textColor="@color/white"
                android:drawablePadding="16dp"
                app:drawableStartCompat="@drawable/ic_wallet"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:text="@{item.name}"
                android:textColor="@color/white"
                android:textAlignment="viewStart"
                app:layout_constraintTop_toBottomOf="@+id/tv_type"
                app:layout_constraintBottom_toTopOf="@+id/tv_balance"
                app:layout_constraintVertical_chainStyle="packed"
                />

            <TextView
                android:id="@+id/tv_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="12dp"
                formattedNum="@{item.balance}"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_name"
                app:layout_constraintBottom_toTopOf="@+id/tv_number"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@{item.currency.symbol}"
                android:textColor="@color/white"
                app:layout_constraintTop_toTopOf="@+id/tv_balance"
                app:layout_constraintBottom_toBottomOf="@+id/tv_balance"
                app:layout_constraintStart_toEndOf="@+id/tv_balance"
                />

            <TextView
                android:id="@+id/tv_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:paddingBottom="12dp"
                android:text="@{item.number}"
                android:textColor="@color/white"
                android:textAlignment="viewStart"
                app:layout_constraintTop_toBottomOf="@+id/tv_balance"
                app:layout_constraintBottom_toTopOf="@+id/iBtn_more"
                />

            <ImageButton
                android:id="@+id/iBtn_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:clickable="false"
                android:src="@drawable/ic_more_horizontal"
                android:background="@android:color/transparent"
                android:paddingBottom="12dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_number"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>