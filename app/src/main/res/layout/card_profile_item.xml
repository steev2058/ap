<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="@drawable/bg_radio_button"
    android:layout_margin="8dp">

        <ImageView
            android:id="@+id/left_image"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="0dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_albaraka_transfer"
            android:layout_gravity="center_vertical"/>

        <!-- Divider -->
        <View
            android:id="@+id/divider_contact_time"
            android:layout_width="1dp"
            android:layout_height="70dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_toEndOf="@id/left_image"
            android:layout_marginStart="15dp"
            android:background="@color/bright_gray"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/divider_contact_time"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/card_service_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Service Name"
                android:textSize="14sp"
                />

            <TextView
                android:id="@+id/card_billing_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Billing Number"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/card_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textSize="12sp" />
        </LinearLayout>
    <Button
        android:id="@+id/btn_delete"
        style="@style/ButtonPrimary3"
        android:layout_width="36dp"
        android:layout_height="39dp"
        android:paddingStart="11dp"
        android:layout_marginTop="20dp"
        android:textSize="12sp"
        android:layout_alignParentEnd="true"
        android:drawableStart="@drawable/ic_delete"
        android:textColor="@color/red"/>
        <Button
            android:id="@+id/btn_search"
            style="@style/ButtonPrimary3"
            android:layout_width="36dp"
            android:layout_height="39dp"
            android:paddingStart="6dp"
            android:layout_marginTop="60dp"
            android:textSize="12sp"
            android:layout_alignParentEnd="true"
            android:drawableStart="@drawable/ic_search_red"
            android:textColor="@color/red"/>




    </RelativeLayout>


