<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.text.TextUtils" />

        <variable
            name="viewModel"
            type="com.apps2you.albaraka.viewmodels.TransactionViewModel" />

        <variable
            name="showDoAnotherTransfer"
            type="boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:filterTouchesWhenObscured="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/iBtn_pdf"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_pdf_file"
            app:layout_constraintBottom_toBottomOf="@+id/toolbar"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/toolbar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/padding_page_horizontal"
                    android:background="@drawable/bg_shadow_white"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/img_logo"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/line_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lines="1"
                        android:text="-------------------------------------------------------------------------"
                        android:textColor="@color/gray_line_view"
                        app:layout_constraintTop_toBottomOf="@id/imageView" />

                    <TextView
                        android:id="@+id/tv_operation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{String.valueOf(viewModel.transaction.operationName)}"
                        android:textColor="@color/textColor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/line_tv" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:text="@string/transfer_type"
                        android:textColor="@color/gray"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_operation" />

                    <TextView
                        android:id="@+id/tv_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{String.valueOf(viewModel.transaction.originalId)}"
                        android:textColor="@color/textColor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_operation" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:text="@string/transaction"
                        android:textColor="@color/gray"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_number" />

                    <TextView
                        android:id="@+id/date_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{viewModel.transaction.date}"
                        android:textColor="@color/textColor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_branch" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:text="@string/Date"
                        android:textColor="@color/gray"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/date_tv" />

                    <View
                        android:id="@+id/line1"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_margin="@dimen/padding_details"
                        android:background="@color/gray_line_view"
                        app:layout_constraintTop_toBottomOf="@id/date_tv" />

                    <TextView
                        android:id="@+id/tv_label_recipient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:text="@string/recipient"
                        android:textColor="@color/gray"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.toCustomer)}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_recipient" />

                    <TextView
                        android:id="@+id/tv_recipient"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{viewModel.transaction.toCustomer}"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/textColor"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.toCustomer)}"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_label_recipient"
                        app:layout_constraintTop_toBottomOf="@+id/line1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:text="@string/branch"
                        android:textColor="@color/gray"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.branch)}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_branch" />

                    <TextView
                        android:id="@+id/tv_branch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{viewModel.transaction.branch}"
                        android:textColor="@color/textColor"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.branch)}"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_number" />

                    <TextView
                        android:id="@+id/tv_label_from"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:text="@string/From"
                        android:textColor="@color/gray"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.fromCustomer)}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_from" />

                    <TextView
                        android:id="@+id/tv_from"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{viewModel.transaction.fromCustomer}"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/textColor"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.fromCustomer)}"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_label_from"
                        app:layout_constraintTop_toBottomOf="@+id/tv_recipient" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:text="@string/Account_Number"
                        android:textColor="@color/gray"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.fromAccountNumber)}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/accountNumber_tv" />

                    <TextView
                        android:id="@+id/accountNumber_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{viewModel.transaction.fromAccountNumber}"
                        android:textColor="@color/textColor"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.fromAccountNumber)}"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_from" />

                    <View
                        android:id="@+id/line2"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_margin="@dimen/padding_details"
                        android:background="@color/gray_line_view"
                        app:layout_constraintTop_toBottomOf="@id/accountNumber_tv" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:text="@string/Amount"
                        android:textColor="@color/gray"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.displayedAmount)}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_amount" />

                    <TextView
                        android:id="@+id/tv_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{viewModel.transaction.displayedAmount}"
                        android:textColor="@color/textColor"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.displayedAmount)}"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/line2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:text="@string/charge"
                        android:textColor="@color/gray"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.charge)}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_charge" />

                    <TextView
                        android:id="@+id/tv_charge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{viewModel.transaction.charge}"
                        android:textColor="@color/textColor"
                        app:goneUnless="@{!TextUtils.isEmpty(viewModel.transaction.charge)}"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_amount" />

                    <TextView
                        android:id="@+id/total_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:text="@string/Total"
                        android:textColor="@color/dark_gray"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/total_tv" />

                    <TextView
                        android:id="@+id/total_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{viewModel.transaction.total}"
                        android:textAlignment="viewEnd"
                        android:textColor="@{viewModel.transaction.sender ? @color/red : @color/blue}"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/total_label"
                        app:layout_constraintTop_toBottomOf="@+id/tv_charge" />

                    <TextView
                        android:id="@+id/total_words_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{viewModel.transaction.amountWords}"
                        android:textAlignment="viewEnd"
                        android:textColor="@{viewModel.transaction.sender ? @color/red : @color/blue}"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/total_label"
                        app:layout_constraintTop_toBottomOf="@+id/total_tv" />

                    <View
                        android:id="@+id/line_view"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:layout_margin="@dimen/padding_details"
                        android:background="@color/gray_line_view"
                        app:goneUnless="@{!viewModel.transaction.description.isEmpty()}"
                        app:layout_constraintTop_toBottomOf="@id/total_words_tv" />

                    <TextView
                        android:id="@+id/description_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:layout_marginTop="12dp"
                        android:text="@string/transfer_Description"
                        android:textColor="@color/dark_gray"
                        android:textSize="16sp"
                        app:goneUnless="@{!viewModel.transaction.description.isEmpty()}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/line_view" />

                    <TextView
                        android:id="@+id/description_tv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_details"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="@dimen/padding_details"
                        android:text="@{viewModel.transaction.description}"
                        android:textColor="@color/gray"
                        app:goneUnless="@{!viewModel.transaction.description.isEmpty()}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/description_label" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_successful_transfer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/padding_page_horizontal"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@id/layout_options"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_success_payment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/img_successful_payment"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_xxlarge"
                        android:gravity="center"
                        android:text="@{showDoAnotherTransfer ? @string/msg_successful_transfer : @string/msg_notice_cannot_be_printed}"
                        android:textColor="@color/dark_gray"
                        android:textSize="@dimen/font_xlarge"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iv_success_payment" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <include
                    android:id="@+id/progressBar"
                    layout="@layout/partial_progressbar"
                    android:visibility="gone" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/layout_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/padding_page_horizontal"
                    android:paddingVertical="@dimen/margin_small"
                    app:existence="@{showDoAnotherTransfer}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/view"
                    app:layout_constraintVertical_bias="1">

                    <Button
                        android:id="@+id/button_ok"
                        style="@style/ButtonPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/return_to_home" />

                    <Space
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/margin_small" />

                    <Button
                        android:id="@+id/button_do_another_transfer"
                        style="@style/WhiteButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/do_another_transfer" />
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>