<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.kyc.fragments.ScannerActivity">

    <TextView
        android:id="@+id/guidelinesTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="عند اختيار فتح الكاميرا:"
        android:textDirection="rtl"
        android:textAlignment="viewStart"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/guidelinesText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="* يرجى توجيه الكاميرا نحو الباركود المتواجد في الجهة الخلفية للهوية الشخصية، وتحديداً في الجزء السفلي.\n* تأكد من وجود إضاءة جيدة في المكان لضمان وضوح الباركود."
        android:textDirection="rtl"
        android:textAlignment="textStart"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/guidelinesTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/guidelinesText2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="عند اختيار استعراض الصور:"
        android:textDirection="rtl"

        android:textAlignment="viewEnd"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/guidelinesText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/guidelinesText3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="* يجب أن تمتلك صورة سابقة للوجه الخلفي للهوية الشخصية، وأن يكون التصوير قد تم بشكل جيد وشامل.\n* تأكد من وضوح الباركود في الصورة، وضمان عدم تغطيته بأي شيء، كما يجب أن يكون خالياً من الغبار أو الانعكاسات(فلاش الموبايل).\n* تجنب أي ارتجاج للكاميرا للصورة الملتقطة لضمان جودة الباركود ووضوحه."
        android:textDirection="rtl"
        android:textAlignment="textStart"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/guidelinesText2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/gifImageView"
        app:layout_constraintTop_toBottomOf="@+id/guidelinesText3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/modal1" />

    <LinearLayout
        android:id="@+id/resultLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="15dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/gifImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:padding="12dp"
            android:text="فتح الكاميرا"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/browseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:layout_marginStart="10dp"
            android:padding="12dp"
            android:text="اختيار من المعرض"
            android:layout_marginTop="0dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
