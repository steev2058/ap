<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.apps2you.albaraka.viewmodels.HomeViewModel" />
    </data>

    <com.apps2you.albaraka.ui.home.MySwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.apps2you.albaraka.utils.CustomScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/card_welcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_home"
                    android:layout_marginEnd="@dimen/padding_home"
                    android:background="@drawable/bg_shadow_white"
                    android:padding="12dp"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tv_user"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_primary"
                        android:gravity="center"
                        android:text="@{viewModel.initial}"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                        android:textColor="@color/white"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@{String.format(@string/home_welcome_with_name, viewModel.userName)}"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                        android:textColor="@color/black"
                        app:layout_constraintBottom_toTopOf="@+id/tv_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_user"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tv_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_last_seen"
                        android:textColor="@color/gray"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tv_name"
                        app:layout_constraintTop_toBottomOf="@+id/tv_name" />

                    <TextView
                        android:id="@+id/tv_date"
                        dateTZ="@{viewModel.user.lastLogin}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/gray"
                        app:layout_constraintStart_toEndOf="@+id/tv_label"
                        app:layout_constraintTop_toTopOf="@+id/tv_label" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <include
                    android:id="@+id/progressBar"
                    layout="@layout/partial_progressbar" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    app:layout_constraintTop_toBottomOf="@+id/card_welcome">

                    <!-- paddingStart, paddingEnd are set programmatically in HomeFragment -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPager"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        app:layout_constraintDimensionRatio="H, 1:0.45"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@+id/viewPager"
                        app:tabBackground="@drawable/tab_selector"
                        app:tabGravity="center"
                        app:tabIndicatorHeight="0dp" />

                    <TextView
                        android:id="@+id/tv_label_menu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_home"
                        android:layout_marginTop="@dimen/padding_home"
                        android:text="@string/quick_menu"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tabLayout" />

                    <TextView
                        android:id="@+id/tv_label_personalize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/padding_home"
                        android:layout_marginEnd="@dimen/padding_home"
                        android:text="@string/personalization"
                        android:textColor="@color/colorPrimary"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:background="@drawable/bg_underlined_border_red"
                        app:layout_constraintTop_toBottomOf="@+id/tabLayout" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_quick_services"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingEnd="8dp"
                        android:clipToPadding="false"
                        android:scrollbars="horizontal"
                        android:fadeScrollbars="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@+id/tv_label_menu"
                        tools:ignore="RtlSymmetry"
                        tools:listitem="@layout/item_quick_service" />


                    <TextView
                        android:id="@+id/tv_label_recent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_home"
                        android:layout_marginEnd="@dimen/padding_home"
                        android:drawablePadding="@dimen/text_padding"
                        android:paddingTop="30dp"
                        android:paddingBottom="30dp"
                        android:paddingStart="@dimen/padding_home"
                        android:paddingEnd="@dimen/padding_home"
                        android:layout_marginTop="20dp"
                        android:text="@string/home_recent_transactions"
                        android:textColor="@color/black"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_shadow_white"
                        app:layout_constraintBottom_toTopOf="@+id/tv_all_transactions"
                        app:layout_constraintTop_toBottomOf="@id/rv_quick_services"
                        app:drawableStartCompat="@drawable/ic_transactions_list"
                        app:drawableEndCompat="@drawable/ic_right_arrow" />
                    <ProgressBar
                        android:id="@+id/transactions_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="?android:attr/progressBarStyleSmall"
                        app:layout_constraintEnd_toEndOf="@id/tv_label_recent"
                        app:layout_constraintTop_toTopOf="@id/tv_label_recent"
                        app:layout_constraintBottom_toBottomOf="@id/tv_label_recent"
                        android:layout_marginEnd="28dp"
                        android:visibility="gone"/>
                    <TextView
                        android:id="@+id/tv_all_transactions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="@dimen/padding_home"
                        android:gravity="center_vertical"
                        android:text="@string/home_see_all"
                        android:visibility="gone"
                        android:textColor="@color/gray_light"
                        app:drawableEndCompat="@drawable/ic_arrow_forward"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_label_recent" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:scrollbars="none"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        app:layout_constraintTop_toBottomOf="@+id/tv_all_transactions"
                        tools:listitem="@layout/item_transaction" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.apps2you.albaraka.utils.CustomScrollView>
    </com.apps2you.albaraka.ui.home.MySwipeRefreshLayout>
</layout>