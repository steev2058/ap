                <TextView
                    android:id="@+id/tv_changePass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:padding="12dp"
                    android:text="@string/password_title"
                    android:textAlignment="viewStart"
                    android:textColor="@color/dark_gray"
                    android:textSize="16sp"
                    android:layout_marginTop="10dp"
                    app:drawableStartCompat="@drawable/ic_change_password"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider_music" />

                <View
                    android:id="@+id/divider_change_pass"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_margin="10dp"
                    android:background="@color/bright_gray"
                    app:layout_constraintTop_toBottomOf="@id/tv_changePass" />



                <TextView
                    android:id="@+id/tv_changePin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:padding="12dp"
                    android:text="@string/pin_title"
                    android:textAlignment="viewStart"
                    android:textColor="@color/dark_gray"
                    android:textSize="16sp"
                    android:layout_marginTop="10dp"
                    app:drawableStartCompat="@drawable/ic_change_pin"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider_change_pass" />

                <View
                    android:id="@+id/divider_change_pin"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_margin="10dp"
                    android:background="@color/bright_gray"
                    app:layout_constraintTop_toBottomOf="@id/tv_changePin" />

                <TextView
                    android:id="@+id/tv_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:padding="12dp"
                    android:text="@string/privacy_policy"
                    android:textAlignment="viewStart"
                    android:textColor="@color/dark_gray"
                    android:textSize="16sp"
                    android:layout_marginTop="10dp"
                    app:drawableStartCompat="@drawable/ic_privacy_policy"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider_change_pin" />

                <View
                    android:id="@+id/divider_privacy"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_margin="10dp"
                    android:background="@color/bright_gray"
                    app:layout_constraintTop_toBottomOf="@id/tv_privacy" />

                <TextView
                    android:id="@+id/tv_change_language"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:layout_marginTop="10dp"
                    android:padding="12dp"
                    android:text="@string/Change_language"
                    android:textAlignment="viewStart"
                    android:textColor="@color/dark_gray"
                    android:textSize="16sp"
                    app:drawableStartCompat="@drawable/ic_language"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider_privacy" />

                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_margin="10dp"
                    android:background="@color/gray"
                    app:layout_constraintTop_toBottomOf="@id/tv_change_language" />

                <TextView
                    android:id="@+id/tv_logout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:gravity="start"
                    android:padding="12dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/logout_title"
                    android:textAlignment="viewStart"
                    android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                    android:textColor="@color/dark_gray"
                    android:textSize="16sp"
                    app:drawableStartCompat="@drawable/ic_exit"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider" />

                <TextView
                    android:id="@+id/tv_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@{String.format(@string/version_number_with_param, BuildConfig.VERSION_NAME)}"
                    android:textColor="@color/dark_gray"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_logout"
                    app:layout_constraintVertical_bias="1.0" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
</layout>