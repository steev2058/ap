<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="item"
            type="com.apps2you.albaraka.data.model.ProductCategory" />

        <variable
            name="isSelected"
            type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="@dimen/padding_home"
            android:background="@{isSelected ? @drawable/bg_border_primary : @drawable/bg_shadow_white}"
            app:layout_constraintHeight_max="95dp"
            app:layout_constraintHeight_min="95dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="95dp"
            app:layout_constraintWidth_min="95dp">

            <ImageView
                android:id="@+id/iv_category"
                imageUrlDef="@{item.icon}"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tv_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_category"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal|bottom"
                android:lines="2"
                android:text="@{item.name}"
                android:textAlignment="gravity"
                android:textColor="@{isSelected ? @color/colorPrimary : @color/colorAccent}"
                android:textSize="12sp" />
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>