<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:fitsSystemWindows="true">

    <data>

        <variable
            name="viewModel"
            type="com.apps2you.albaraka.viewmodels.LoginViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            tools:context=".ui.registration.LoginFragment">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="25dp"
                android:scaleType="fitXY"
                android:src="@drawable/img_logo"
                app:layout_constraintBottom_toTopOf="@+id/textView_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/textView_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/login_welcome"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/x_Title"
                app:layout_constraintBottom_toTopOf="@+id/textView_intro"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imageView" />

            <TextView
                android:id="@+id/textView_intro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ems="12"
                android:padding="@dimen/text_padding"
                android:text="@string/enter_your_info"
                android:textAlignment="center"
                android:textColor="@color/dark_gray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView_title" />

            <!--todo change phone binding to cif-->
            <com.apps2you.albaraka.utils.CustomTextInputLayout
                android:id="@+id/input_cif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="18dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@+id/textView_intro">

                <com.apps2you.albaraka.utils.NoMenuEditText
                    android:id="@+id/et_cif_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext_selector"
                    android:hint="@string/cif_number"
                    android:inputType="number"
                    android:padding="12dp"
                    android:text="@={viewModel.user.cif_number}"
                    android:textAlignment="viewStart"
                    android:textColor="@color/dark_gray"
                    android:textColorHint="@color/gray"
                    android:textSize="14sp" />
            </com.apps2you.albaraka.utils.CustomTextInputLayout>

            <com.apps2you.albaraka.utils.CustomTextInputLayout
                android:id="@+id/textInput_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="18dp"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@+id/input_cif"
                app:passwordToggleEnabled="true">

                <com.apps2you.albaraka.utils.NoMenuEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext_selector"
                    android:hint="@string/password"
                    android:inputType="textPassword"
                    android:padding="6dp"
                    android:text="@={viewModel.user.password}"
                    android:textAlignment="viewStart"
                    android:textColor="@color/dark_gray"
                    android:textColorHint="@color/gray"
                    android:textSize="14sp"
                    app:hintEnabled="false" />

            </com.apps2you.albaraka.utils.CustomTextInputLayout>
            <!--        <TextInputLayout-->
            <!--            android:layout_width="match_parent"-->
            <!--            android:layout_height="wrap_content"-->
            <!--    -->
