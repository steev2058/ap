            <TextView
                android:id="@+id/fingerPrintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="@string/login_using_finger_print"
                android:textColor="@color/dark_gray"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/submit_button" />

            <ImageView
                android:id="@+id/iv_fingerPrint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_fingerprint"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/fingerPrintText" />
            <View
                android:id="@+id/divider_details"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="@color/bright_gray"
                app:layout_constraintTop_toBottomOf="@id/iv_fingerPrint" />
            <Button
                android:id="@+id/btn_account"
                style="@style/ButtonGuest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_marginTop="35dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="طلب حساب إلكتروني"
                app:drawableTopCompat="@drawable/ic_logo_outlined"
                app:layout_constraintTop_toBottomOf="@+id/iv_fingerPrint"
                app:layout_constraintEnd_toStartOf="@+id/btn_application"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <Button
                android:id="@+id/btn_application"
                style="@style/ButtonGuest"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/margin_guest"
                android:text="اشتراك بتطبيق البركة"
                app:drawableTopCompat="@drawable/ic_mobile_phone"
                app:layout_constraintBottom_toBottomOf="@id/btn_account"
                app:layout_constraintEnd_toStartOf="@id/btn_changeP"
                app:layout_constraintStart_toEndOf="@id/btn_account"
                app:layout_constraintTop_toTopOf="@+id/btn_account" />

            <Button
                android:id="@+id/btn_changeP"
                style="@style/ButtonGuest"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/margin_guest"
                android:text="تغيير كلمة السر"
                app:drawableTopCompat="@drawable/change_pass_icon"
                app:layout_constraintBottom_toBottomOf="@id/btn_account"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/btn_application"
                app:layout_constraintTop_toTopOf="@+id/btn_account" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>